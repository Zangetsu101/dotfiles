# Shared interactive Bash configuration.

set -o vi

_dotfiles_bash_dir="${BASH_SOURCE[0]%/*}"
source "$_dotfiles_bash_dir/aliases.bash"
source "$_dotfiles_bash_dir/tools.bash"
source "$_dotfiles_bash_dir/ssh-agent.bash"

# Load machine- and employer-specific settings kept in this checkout.
[ -f "$_dotfiles_bash_dir/bashrc.local" ] && source "$_dotfiles_bash_dir/bashrc.local"

unset _dotfiles_bash_dir
