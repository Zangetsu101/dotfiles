{
  "name": "dotfiles-pi-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/sync-pi-dependencies.mjs --check",
    "eval:background-monitor": "node --experimental-strip-types evals/background-monitor/run.ts",
    "sync:pi": "node scripts/sync-pi-dependencies.mjs",
    "test": "node --experimental-strip-types --test --test-reporter=spec tests/**/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "7.0.2"
  }
}
