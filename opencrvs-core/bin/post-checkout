#!/usr/bin/env bash
# Installed by `worktree-overlay`: at <git common dir>/hooks/post-checkout, and
# at <core.hooksPath>/post-checkout in every worktree when that path is relative.
#
# Git has no hook for `git worktree add`, but the checkout it performs fires
# post-checkout with the new worktree as cwd. It also fires on every ordinary
# checkout/switch, so worktree-overlay stays silent once the links exist, and
# a failure here never blocks the checkout.
top=$(git rev-parse --show-toplevel)
"$(dirname "$(readlink -f "$0")")/worktree-overlay" --quiet "$top" || true

# The old HEAD ($1) is the null SHA only for a new worktree (or a clone).
# Then install the dependencies. A branch switch does not install.
#
# The install runs detached in the background, so `git worktree add` returns
# at once. The hook closes stdin, stdout and stderr for the install, because a
# caller that reads the hook output through a pipe waits for the pipe to close.
# The log goes to the git dir of the worktree, so it is not in `git status`.
# The log ends with "pnpm install: done" or "pnpm install: failed".
if [[ ${1-} =~ ^0+$ ]] && [ -f "$top/pnpm-lock.yaml" ]; then
  log="$(git rev-parse --absolute-git-dir)/pnpm-install.log"
  echo "post-checkout: new worktree, pnpm install runs in the background, log: $log" >&2
  cd "$top" || exit 0
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE setsid bash -c '
    if pnpm install --frozen-lockfile --prefer-offline; then
      echo "pnpm install: done"
    else
      echo "pnpm install: failed, run it by hand"
    fi' </dev/null >"$log" 2>&1 &
fi
exit 0
